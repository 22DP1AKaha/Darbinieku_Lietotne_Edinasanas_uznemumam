@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model EIIOS.ViewModels.InventoryManagementViewModel

@{
    ViewData["Title"] = Localizer["IngredientsTitle"];
}

<!-- Header Section -->
<section class="ingredients-header bg-primary text-white py-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3">@Localizer["IngredientsTitle"]</h1>
        <p class="lead">@Localizer["IngredientsSubtitle"]</p>
    </div>
</section>

<!-- Add Ingredient Section -->
<section class="add-ingredient-section py-5 bg-light">
    <div class="container">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h3 class="fw-bold mb-4 text-center">@Localizer["AddNewIngredient"]</h3>
            <form asp-action="Manage" method="post" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Localizer["Name"]</label>
                    <input asp-for="NewItem.Name" class="form-control" placeholder="@Localizer["NamePlaceholder"]" />
                    <span asp-validation-for="NewItem.Name" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Localizer["Unit"]</label>
                    <input asp-for="NewItem.Unit" class="form-control" placeholder="@Localizer["UnitPlaceholder"]" />
                    <span asp-validation-for="NewItem.Unit" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localizer["CurrentQuantity"]</label>
                    <input asp-for="NewItem.CurrentQuantity" class="form-control" type="number" step="0.001" />
                    <span asp-validation-for="NewItem.CurrentQuantity" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localizer["MinimumQuantity"]</label>
                    <input asp-for="NewItem.MinimumQuantity" class="form-control" type="number" step="0.001" />
                    <span asp-validation-for="NewItem.MinimumQuantity" class="text-danger"></span>
                </div>

                <div class="col-12 text-center">
                    <button type="submit" class="btn btn-success px-5 mt-3">
                        <i class="fas fa-plus"></i> @Localizer["AddIngredientButton"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Ingredients List -->
<section class="ingredients-list-section py-5">
    <div class="container">
        <h3 class="fw-bold mb-4 text-center">@Localizer["CurrentIngredientsTitle"]</h3>

        <div class="row g-4">
            @foreach (var item in Model.InventoryItems)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="ingredient-card bg-white rounded shadow-sm p-4 h-100 border-0 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">@item.Name</h5>
                            @if (item.IsLowStock)
                            {
                                <span class="badge bg-danger">@Localizer["LowStock"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Localizer["InStock"]</span>
                            }
                        </div>
                        <p class="text-muted mb-1">
                            <strong>@Localizer["Unit"]:</strong> @item.Unit
                        </p>
                        <p class="text-muted mb-1">
                            <strong>@Localizer["CurrentQuantity"]:</strong> @String.Format("{0:0.##}", item.CurrentQuantity)
                        </p>
                        <p class="text-muted mb-3">
                            <strong>@Localizer["MinimumQuantity"]:</strong> @String.Format("{0:0.##}", item.MinimumQuantity)
                        </p>


                        <div class="d-flex justify-content-between">
                            <button class="btn btn-outline-primary btn-sm edit-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    data-id="@item.Id"
                                    data-name="@item.Name"
                                    data-unit="@item.Unit"
                                    data-current="@item.CurrentQuantity"
                                    data-minimum="@item.MinimumQuantity">
                                <i class="fas fa-edit"></i> @Localizer["Edit"]
                            </button>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('@Localizer["AreYouSureDelete"]');">
                                    <i class="fas fa-trash"></i> @Localizer["Delete"]
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <form asp-action="Edit" method="post">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="editModalLabel">@Localizer["EditIngredient"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit-id" name="Id" />
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Name"]</label>
                        <input id="edit-name" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Unit"]</label>
                        <input id="edit-unit" name="Unit" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["CurrentQuantity"]</label>
                        <input id="edit-current" name="CurrentQuantity" type="number" step="0.001" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["MinimumQuantity"]</label>
                        <input id="edit-minimum" name="MinimumQuantity" type="number" step="0.001" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-success">@Localizer["Update"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editButtons = document.querySelectorAll(".edit-btn");
            editButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    document.getElementById("edit-id").value = this.dataset.id;
                    document.getElementById("edit-name").value = this.dataset.name;
                    document.getElementById("edit-unit").value = this.dataset.unit;
                    document.getElementById("edit-current").value = this.dataset.current;
                    document.getElementById("edit-minimum").value = this.dataset.minimum;
                });
            });
        });
    </script>
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #fffdd0 0%, #d9d7b6 100%);
        --shadow-soft: 0 10px 40px rgba(0,0,0,0.1);
        --shadow-hover: 0 20px 60px rgba(0,0,0,0.15);
    }

    .ingredients-header {
        background: var(--gradient-primary);
        color: #333 !important;
    }

        .ingredients-header h1,
        .ingredients-header p {
            color: #333 !important;
        }

    .ingredient-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

        .ingredient-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }

    .display-4 {
        font-size: 3.5rem;
    }

    @@media (max-width: 768px) {
        .display-4 {
            font-size: 2.5rem;
        }
    }
</style>
