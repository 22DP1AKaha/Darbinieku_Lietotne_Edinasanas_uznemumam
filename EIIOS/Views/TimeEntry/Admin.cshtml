@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model EIIOS.ViewModels.TimeEntryAdminViewModel
@{
    ViewData["Title"] = Localizer["TimeEntryAdmin"];
}

<!-- Admin Section -->
<section class="admin-section py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="fw-bold">@Localizer["TimeEntryAdmin"]</h2>
                    <div>
                        <span class="badge bg-warning me-2">
                            @Model.PendingCount @Localizer["Pending"]
                        </span>
                        <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>
                            @Localizer["BackToDashboard"]
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["StartDate"]</label>
                                <input type="date" asp-for="Filter.StartDate" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["EndDate"]</label>
                                <input type="date" asp-for="Filter.EndDate" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Employee"]</label>
                                <select asp-for="Filter.EmployeeId" class="form-select">
                                    <option value="">@Localizer["AllEmployees"]</option>
                                    @foreach (var employee in ViewBag.Employees)
                                    {
                                        <option value="@employee.Id">@employee.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Status"]</label>
                                <select asp-for="Filter.Status" class="form-select">
                                    <option value="">@Localizer["AllStatuses"]</option>
                                    <option value="Pending">@Localizer["Pending"]</option>
                                    <option value="Approved">@Localizer["Approved"]</option>
                                    <option value="Rejected">@Localizer["Rejected"]</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-filter me-2"></i>
                                    @Localizer["Filter"]
                                </button>
                                <a href="@Url.Action("Admin")" class="btn btn-outline-secondary">
                                    @Localizer["Clear"]
                                </a>
                                <button type="button" id="bulkApproveBtn" class="btn btn-success" disabled>
                                    <i class="fas fa-check-circle me-2"></i>
                                    @Localizer["ApproveSelected"]
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Time Entries Table -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        @if (Model.TimeEntries.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>
                                                <input type="checkbox" id="selectAll" />
                                            </th>
                                            <th>@Localizer["Employee"]</th>
                                            <th>@Localizer["Date"]</th>
                                            <th>@Localizer["ClockIn"]</th>
                                            <th>@Localizer["ClockOut"]</th>
                                            <th>@Localizer["TotalHours"]</th>
                                            <th>@Localizer["Status"]</th>
                                            <th>@Localizer["ApprovedBy"]</th>
                                            <th>@Localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in Model.TimeEntries)
                                        {
                                            <tr>
                                                <td>
                                                    @if (entry.Status == TimeEntryStatus.Pending)
                                                    {
                                                        <input type="checkbox" class="entry-checkbox" value="@entry.Id" />
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@entry.Employee?.FullName</strong>
                                                    <br />
                                                    <small class="text-muted">@entry.Employee?.Email</small>
                                                </td>
                                                <td>@entry.Date.ToString("MMM dd, yyyy")</td>
                                                <td>@entry.ClockIn.ToLocalTime().ToString("MMM dd hh:mm tt")</td>
                                                <td>
                                                    @if (entry.ClockOut.HasValue)
                                                    {
                                                        @entry.ClockOut.Value.ToLocalTime().ToString("MMM dd hh:mm tt")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">@Localizer["InProgress"]</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (entry.TotalHours.HasValue)
                                                    {
                                                        <span class="fw-bold">@entry.TotalHours.Value.ToString("0.00")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-@(entry.Status == TimeEntryStatus.Approved ? "success" : entry.Status == TimeEntryStatus.Rejected ? "danger" : "warning")">
                                                        @entry.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (entry.ApprovedBy != null)
                                                    {
                                                        <span>@entry.ApprovedBy.FullName</span>
                                                        <br />
                                                        <small class="text-muted">@entry.ApprovedAt?.ToLocalTime().ToString("MMM dd, yyyy")</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        @if (entry.Status == TimeEntryStatus.Pending)
                                                        {
                                                            <form asp-action="Approve" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@entry.Id" />
                                                                <button type="submit" class="btn btn-success btn-sm">
                                                                    <i class="fas fa-check"></i>
                                                                </button>
                                                            </form>
                                                            <button type="button" class="btn btn-danger btn-sm"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#rejectModal"
                                                                    data-entry-id="@entry.Id"
                                                                    data-employee-name="@entry.Employee?.FullName">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        }
                                                        <a href="@Url.Action("Details", new { id = entry.Id })"
                                                           class="btn btn-info btn-sm"
                                                           title="@Localizer["ViewDetails"]">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">@Localizer["NoTimeEntriesFound"]</h5>
                                <p class="text-muted">@Localizer["NoEntriesMatchFilter"]</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["RejectTimeEntry"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>@Localizer["RejectConfirmation"]: <strong id="employeeName"></strong></p>
                <form id="rejectForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="rejectEntryId" name="id" />
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">@Localizer["RejectionReason"] (Optional)</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason" rows="3"
                                  placeholder="@Localizer["RejectionReasonPlaceholder"]"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('rejectForm').submit();">
                    @Localizer["Reject"]
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #fdf6e3;
    }

    .card {
        background-color: #fffbea;
        border-radius: 1rem;
    }

    .table {
        margin-bottom: 0;
    }

        .table th {
            border-top: none;
            font-weight: 600;
            padding: 1rem;
        }

        .table td {
            padding: 1rem;
            vertical-align: middle;
        }

    .btn {
        border-radius: 0.5rem;
    }

    .badge {
        font-size: 0.75rem;
    }
</style>

@section Scripts {
    <script>
        // Reject modal functionality
        const rejectModal = document.getElementById('rejectModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const entryId = button.getAttribute('data-entry-id');
                const employeeName = button.getAttribute('data-employee-name');

                document.getElementById('rejectEntryId').value = entryId;
                document.getElementById('employeeName').textContent = employeeName;

                // Set form action
                const form = document.getElementById('rejectForm');
                form.action = '@Url.Action("Reject")';
            });
        }

        // Bulk approve functionality
        document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('selectAll');
            const checkboxes = document.querySelectorAll('.entry-checkbox');
            const bulkApproveBtn = document.getElementById('bulkApproveBtn');

            // Select all functionality
            selectAll.addEventListener('change', function () {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = selectAll.checked;
                });
                updateBulkApproveButton();
            });

            // Individual checkbox change
            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateBulkApproveButton);
            });

            function updateBulkApproveButton() {
                const checkedCount = document.querySelectorAll('.entry-checkbox:checked').length;
                bulkApproveBtn.disabled = checkedCount === 0;
                if (checkedCount > 0) {
                    bulkApproveBtn.textContent = `Approve Selected (${checkedCount})`;
                } else {
                    bulkApproveBtn.textContent = 'Approve Selected';
                }
            }

            // Bulk approve action
            bulkApproveBtn.addEventListener('click', function () {
                const selectedIds = Array.from(document.querySelectorAll('.entry-checkbox:checked'))
                    .map(checkbox => parseInt(checkbox.value));

                if (selectedIds.length === 0) return;

                if (!confirm(`Are you sure you want to approve ${selectedIds.length} time entries?`)) {
                    return;
                }

                // Send AJAX request
                fetch('@Url.Action("BulkApprove")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ timeEntryIds: selectedIds })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload(); // Reload to see changes
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred during bulk approval.');
                });
            });
        });
    </script>
}