@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model EIIOS.ViewModels.TimeEntryEditViewModel
@{
    ViewData["Title"] = Localizer["EditTimeEntry"];
}

<!-- Edit Section -->
<section class="edit-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mx-auto">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-0 py-3">
                        <h4 class="fw-bold mb-0">
                            <i class="fas fa-edit me-2"></i>
                            @Localizer["EditTimeEntry"]
                        </h4>
                    </div>
                    <div class="card-body">
                        <form asp-action="Edit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />

                            <div class="mb-3">
                                <label asp-for="ClockIn" class="form-label fw-bold">@Localizer["ClockIn"]</label>
                                <input asp-for="ClockIn" class="form-control" />
                                <span asp-validation-for="ClockIn" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ClockOut" class="form-label fw-bold">@Localizer["ClockOut"]</label>
                                <input asp-for="ClockOut" class="form-control" />
                                <span asp-validation-for="ClockOut" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label fw-bold">@Localizer["Notes"]</label>
                                <textarea asp-for="Notes" class="form-control" rows="4"
                                          placeholder="@Localizer["NotesPlaceholder"]"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-outline-secondary me-md-2">
                                    @Localizer["Cancel"]
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i>@Localizer["SaveChanges"]
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    body {
        background-color: #fdf6e3;
    }

    .card {
        background-color: #fffbea;
        border-radius: 1rem;
    }

    .btn {
        border-radius: 0.5rem;
        font-weight: 600;
    }

    .form-control {
        border-radius: 0.5rem;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}