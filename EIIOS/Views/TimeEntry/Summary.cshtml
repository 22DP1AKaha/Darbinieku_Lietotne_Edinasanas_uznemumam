@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model EIIOS.ViewModels.TimeEntrySummaryViewModel
@{
    ViewData["Title"] = Localizer["TimeSummary"];
}

<!-- Summary Section -->
<section class="summary-section py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="fw-bold">@Localizer["TimeSummary"]</h2>
                    <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>
                        @Localizer["BackToDashboard"]
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["StartDate"]</label>
                                <input type="date" asp-for="StartDate" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["EndDate"]</label>
                                <input type="date" asp-for="EndDate" class="form-control" />
                            </div>
                            @if (ViewBag.Employees != null)
                            {
                                <div class="col-md-3">
                                    <label class="form-label">@Localizer["Employee"]</label>
                                    <select asp-for="EmployeeId" class="form-select">
                                        <option value="">@Localizer["AllEmployees"]</option>
                                        @foreach (var employee in ViewBag.Employees)
                                        {
                                            <option value="@employee.Id">@employee.FullName</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-filter me-2"></i>
                                    @Localizer["Filter"]
                                </button>
                                <a href="@Url.Action("Summary")" class="btn btn-outline-secondary">
                                    @Localizer["Clear"]
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-primary text-white">
                    <div class="card-body text-center">
                        <h3 class="fw-bold">@Model.TotalHours.ToString("0.00")</h3>
                        <p class="mb-0">@Localizer["TotalHoursWorked"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success text-white">
                    <div class="card-body text-center">
                        <h3 class="fw-bold">@Model.TotalEntries</h3>
                        <p class="mb-0">@Localizer["TotalEntries"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body text-center">
                        <h3 class="fw-bold">@Model.Summary.Count</h3>
                        <p class="mb-0">@Localizer["TotalEmployees"]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employee Summary Table -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-0 py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="fas fa-users me-2"></i>
                            @Localizer["EmployeeSummary"]
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Summary.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>@Localizer["Employee"]</th>
                                            <th>@Localizer["TotalHours"]</th>
                                            <th>@Localizer["EntryCount"]</th>
                                            <th>@Localizer["AverageHoursPerDay"]</th>
                                            <th>@Localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var employeeSummary in Model.Summary)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@employeeSummary.Employee.FullName</strong>
                                                    <br />
                                                    <small class="text-muted">@employeeSummary.Employee.Email</small>
                                                </td>
                                                <td>
                                                    <span class="fw-bold text-primary">@employeeSummary.TotalHours.ToString("0.00")</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary">@employeeSummary.EntryCount</span>
                                                </td>
                                                <td>
                                                    <span class="fw-bold text-success">@employeeSummary.AverageHoursPerDay.ToString("0.00")</span>
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("History", new { employeeId = employeeSummary.Employee.Id, startDate = Model.StartDate, endDate = Model.EndDate })"
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-eye me-1"></i>
                                                        @Localizer["ViewDetails"]
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="bg-light">
                                        <tr>
                                            <td><strong>@Localizer["Total"]</strong></td>
                                            <td><strong class="text-primary">@Model.TotalHours.ToString("0.00")</strong></td>
                                            <td><strong class="text-secondary">@Model.TotalEntries</strong></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">@Localizer["NoDataAvailable"]</h5>
                                <p class="text-muted">@Localizer["NoTimeEntriesInPeriod"]</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Date Range Info -->
        <div class="row mt-3">
            <div class="col-12 text-center">
                <p class="text-muted">
                    @Localizer["ShowingDataFor"]:
                    <strong>@Model.StartDate.ToString("MMM dd, yyyy")</strong>
                    @Localizer["To"]
                    <strong>@Model.EndDate.ToString("MMM dd, yyyy")</strong>
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    body {
        background-color: #fdf6e3;
    }

    .card {
        background-color: #fffbea;
        border-radius: 1rem;
    }

    .table {
        margin-bottom: 0;
    }

        .table th {
            border-top: none;
            font-weight: 600;
            padding: 1rem;
        }

        .table td {
            padding: 1rem;
            vertical-align: middle;
        }

    .btn {
        border-radius: 0.5rem;
    }

    .bg-primary, .bg-success, .bg-info {
        border: none;
    }
</style>