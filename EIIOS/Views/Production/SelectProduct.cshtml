@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<EIIOS.Models.ProductModel>

@{
    ViewData["Title"] = Localizer["SelectProductTitle"];
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold">@Localizer["SelectProductHeading"]</h1>
            <p class="text-muted">@Localizer["SelectProductSubheading"]</p>
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title fw-bold">@product.Name</h5>
                                    <p class="card-text text-muted small">@product.Description</p>
                                    <p class="mb-1"><strong>@Localizer["BasePrice"]:</strong> @product.BasePrice.ToString("C")</p>
                                    <p class="mb-0"><strong>@Localizer["PreparationTime"]:</strong> @product.PreparationTime @Localizer["Minutes"]</p>
                                </div>
                                <div class="mt-3">
                                    <a asp-controller="Production"
                                       asp-action="Create"
                                       asp-route-id="@product.Id"
                                       class="btn btn-primary w-100">
                                        @Localizer["ProduceNow"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                @Localizer["NoProductsAvailable"]
            </div>
        }
    </div>
</section>

<style>
    .card {
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

    .btn-primary {
        background-color: #bca66c;
        border: none;
    }

        .btn-primary:hover {
            background-color: #a8945f;
        }
</style>
