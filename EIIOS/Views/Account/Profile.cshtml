@model EIIOS.Models.UserModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Profile"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-circle me-2"></i>@Localizer["UserProfile"]
                    </h4>
                </div>
                <div class="card-body p-4">
                    <!-- User Info -->
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Localizer["PersonalInformation"]</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>@Localizer["FullName"]:</strong></td>
                                    <td>@Model.FullName</td>
                                </tr>
                                <tr>
                                    <td><strong>@Localizer["Username"]:</strong></td>
                                    <td>@Model.Username</td>
                                </tr>
                                <tr>
                                    <td><strong>@Localizer["Email"]:</strong></td>
                                    <td>
                                        @Model.Email
                                        @if (Model.IsEmailVerified)
                                        {
                                            <span class="badge bg-success ms-2">
                                                <i class="fas fa-check me-1"></i>@Localizer["Verified"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning ms-2">
                                                <i class="fas fa-exclamation-triangle me-1"></i>@Localizer["NotVerified"]
                                            </span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>@Localizer["Role"]:</strong></td>
                                    <td>
                                        <span class="badge bg-info">@Model.Role</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5>@Localizer["AccountInformation"]</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>@Localizer["MemberSince"]:</strong></td>
                                    <td>@Model.CreatedAt.ToString("dd.MM.yyyy")</td>
                                </tr>
                                <tr>
                                    <td><strong>@Localizer["LastUpdated"]:</strong></td>
                                    <td>@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td><strong>@Localizer["AccountStatus"]:</strong></td>
                                    <td>
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>@Localizer["Active"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle me-1"></i>@Localizer["Inactive"]
                                            </span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("EditProfile", "Account")" class="btn btn-primary">
                                    <i class="fas fa-edit me-2"></i>@Localizer["EditProfile"]
                                </a>
                                <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary">
                                    <i class="fas fa-key me-2"></i>@Localizer["ChangePassword"]
                                </a>
                                @if (!Model.IsEmailVerified)
                                {
                                    <a href="@Url.Action("ResendVerification", "Account")" class="btn btn-outline-warning">
                                        <i class="fas fa-envelope me-2"></i>@Localizer["ResendVerification"]
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>