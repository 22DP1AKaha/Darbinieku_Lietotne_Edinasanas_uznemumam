@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["EmailVerificationRequired"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <i class="fas fa-envelope fa-4x text-warning mb-4"></i>
                    <h2>@Localizer["VerifyYourEmail"]</h2>
                    <p class="text-muted mb-4">
                        @Localizer["VerificationEmailSentTo"] <strong>@ViewBag.Email</strong>
                    </p>
                    <p>@Localizer["CheckInbox"]</p>

                    <hr class="my-4">

                    <p class="text-muted small">@Localizer["DidntReceiveEmail"]</p>
                    <form asp-action="ResendVerification" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@ViewBag.UserId" />
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-redo me-1"></i>@Localizer["ResendEmail"]
                        </button>
                    </form>

                    <div class="mt-4">
                        <a asp-action="Login" class="btn btn-link">@Localizer["BackToLogin"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>