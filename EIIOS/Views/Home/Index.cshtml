@model IEnumerable<ProductModel>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Menu - EIIOS";
    var categories = ViewBag.Categories as List<CategoryModel> ?? new List<CategoryModel>();
}

<!-- Header Section -->
<section class="menu-header bg-primary text-white py-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="fw-bold mb-2">Our Menu</h1>
                <p class="mb-0">Discover our delicious offerings with special discounts</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Discounts Section -->
<section class="featured-discounts py-4 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                @if (Model != null && Model.Any(p => p.DiscountProducts?.Any(dp => dp.Discount.IsCurrentlyActive) == true))
                {
                    <div class="discount-carousel d-flex gap-3 overflow-auto pb-3">
                        @foreach (var product in Model
                                            .Where(p => p.DiscountProducts?.Any(dp => dp.Discount.IsCurrentlyActive) == true)
                                            .Take(6))
                        {
                            var activeDiscount = product.DiscountProducts?.FirstOrDefault(dp => dp.Discount.IsCurrentlyActive)?.Discount;
                            if (activeDiscount != null)
                            {
                                <div class="discount-card bg-white rounded shadow-sm p-3 flex-shrink-0" style="min-width: 200px;">
                                    <div class="position-relative">
                                        <div class="product-image bg-light rounded mb-2" style="height: 120px;">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid rounded" style="height: 100%; width: 100%; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center h-100">
                                                    <i class="fas fa-utensils fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="discount-badge position-absolute top-0 end-0">
                                            <span class="badge bg-danger rounded-circle">
                                                -@(activeDiscount.DiscountType == DiscountType.Percentage ? $"{activeDiscount.DiscountValue:0}%" : $"${activeDiscount.DiscountValue:0.00}")
                                            </span>
                                        </div>
                                    </div>
                                    <h6 class="mb-1">@product.Name</h6>
                                    <div class="price-info">
                                        @if (activeDiscount.DiscountType == DiscountType.Percentage)
                                        {
                                            var discountedPrice = product.BasePrice * (1 - activeDiscount.DiscountValue / 100);
                                            <span class="text-decoration-line-through text-muted small">$@product.BasePrice.ToString("0.00")</span>
                                            <span class="text-success fw-bold">$@discountedPrice.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            var discountedPrice = product.BasePrice - activeDiscount.DiscountValue;
                                            <span class="text-decoration-line-through text-muted small">$@product.BasePrice.ToString("0.00")</span>
                                            <span class="text-success fw-bold">$@discountedPrice.ToString("0.00")</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted">No discounted products available.</p>
                }
            </div>
        </div>
    </div>
</section>

<!-- Search and Filter Section -->
<section class="search-filters py-4">
    <div class="container">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control border-start-0" placeholder="Search menu items...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Name" selected="@(ViewBag.Category == category.Name)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortBy" class="form-select">
                    <option value="name" selected="@(ViewBag.SortBy == "name")">Sort by Name</option>
                    <option value="price" selected="@(ViewBag.SortBy == "price")">Price: Low to High</option>
                    <option value="pricedesc" selected="@(ViewBag.SortBy == "pricedesc")">Price: High to Low</option>
                    <option value="category" selected="@(ViewBag.SortBy == "category")">Category</option>
                    <option value="discount" selected="@(ViewBag.SortBy == "discount")">Best Discounts</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</section>

<!-- Menu Items Section -->
<section class="menu-items py-4">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    var activeDiscount = product.DiscountProducts?.FirstOrDefault(dp => dp.Discount.IsCurrentlyActive)?.Discount;
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="card menu-item-card h-100 border-0 shadow-sm hover-scale">
                            <div class="position-relative">
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid rounded-top" style="height: 100%; width: 100%; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <i class="fas fa-utensils fa-3x text-muted"></i>
                                    }
                                </div>
                                @if (activeDiscount != null)
                                {
                                    <div class="discount-badge position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-danger fs-6">
                                            -@(activeDiscount.DiscountType == DiscountType.Percentage ? $"{activeDiscount.DiscountValue:0}%" : $"${activeDiscount.DiscountValue:0.00}")
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="card-body d-flex flex-column">
                                @if (product.ProductCategories?.Any() == true)
                                {
                                    <span class="badge bg-light text-dark small">@product.ProductCategories.First().Category?.Name</span>
                                }
                                <h5 class="card-title mb-2">@product.Name</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description)
                                </p>
                                @if (product.PreparationTime.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="fas fa-clock me-1"></i>@product.PreparationTime mins</small>
                                    </div>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <div class="price-info">
                                        @if (activeDiscount != null)
                                        {
                                            var discountedPrice = activeDiscount.DiscountType == DiscountType.Percentage
                                            ? product.BasePrice * (1 - activeDiscount.DiscountValue / 100)
                                            : product.BasePrice - activeDiscount.DiscountValue;

                                            <div>
                                                <span class="text-decoration-line-through text-muted small">$@product.BasePrice.ToString("0.00")</span>
                                                <span class="text-success fw-bold fs-5">$@discountedPrice.ToString("0.00")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-primary fw-bold fs-5">$@product.BasePrice.ToString("0.00")</span>
                                        }
                                    </div>
                                    <button class="btn btn-warning btn-sm add-to-cart-btn" data-product-id="@product.Id">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12 text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No menu items found</h4>
                    <p class="text-muted">Try adjusting your search criteria or browse all categories.</p>
                    <a href="@Url.Action("Index")" class="btn btn-primary">View All Items</a>
                </div>
            </div>
        }
    </div>
</section>


<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #fdfdb4 0%, #d9d7b6 100%);
        --gradient-secondary: linear-gradient(135deg, #f7dc6f 0%, #e6b800 100%);
        --shadow-soft: 0 10px 40px rgba(0,0,0,0.1);
        --shadow-hover: 0 20px 60px rgba(0,0,0,0.15);
    }

    .menu-header {
        background: var(--gradient-primary);
        color: #333 !important;
    }

        .menu-header h1,
        .menu-header p {
            color: #333 !important;
        }

    .theme-toggle {
        background: rgba(255,255,255,0.2);
        border-radius: 20px;
        padding: 5px 10px;
        display: flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

    .discount-carousel {
        scrollbar-width: thin;
        scrollbar-color: #ffc107 transparent;
    }

        .discount-carousel::-webkit-scrollbar {
            height: 6px;
        }

        .discount-carousel::-webkit-scrollbar-track {
            background: transparent;
        }

        .discount-carousel::-webkit-scrollbar-thumb {
            background: #ffc107;
            border-radius: 3px;
        }

    .menu-item-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

        .menu-item-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover) !important;
        }

    .discount-badge .badge {
        font-size: 0.8rem;
        padding: 5px 8px;
    }

    .add-to-cart-btn {
        border-radius: 50%;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

        .add-to-cart-btn:hover {
            transform: scale(1.1);
        }

    .hover-scale {
        transition: all 0.3s ease;
    }

    .search-filters {
        background: #f8f9fa;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Add to cart functionality
        document.querySelectorAll('.add-to-cart-btn').forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.getAttribute('data-product-id');

                // Show loading state
                const originalContent = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                this.disabled = true;

                fetch('@Url.Action("AddToCart", "Menu")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({
                        productId: productId,
                        quantity: 1
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success feedback
                        this.innerHTML = '<i class="fas fa-check"></i>';
                        this.classList.remove('btn-warning');
                        this.classList.add('btn-success');

                        // Reset after 2 seconds
                        setTimeout(() => {
                            this.innerHTML = originalContent;
                            this.classList.remove('btn-success');
                            this.classList.add('btn-warning');
                            this.disabled = false;
                        }, 2000);
                    } else {
                        // Show error feedback
                        this.innerHTML = '<i class="fas fa-times"></i>';
                        this.classList.add('btn-danger');

                        setTimeout(() => {
                            this.innerHTML = originalContent;
                            this.classList.remove('btn-danger');
                            this.disabled = false;
                        }, 2000);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    this.innerHTML = originalContent;
                    this.disabled = false;
                });
            });
        });

        // Theme toggle functionality
        document.querySelector('.theme-toggle')?.addEventListener('click', function() {
            document.body.classList.toggle('dark-theme');
        });
    });
</script>