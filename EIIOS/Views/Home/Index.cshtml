@model EIIOS.ViewModels.MenuViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["MenuTitle"];
    var isAdmin = ViewBag.IsAdmin ?? false;
    var allCategories = ViewBag.AllCategories as List<CategoryModel> ?? new List<CategoryModel>();
    var allergens = ViewBag.Allergens as List<AllergenModel> ?? new List<AllergenModel>();
}

<!-- Header Section -->
<section class="menu-header bg-primary text-white py-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="fw-bold mb-2">@Localizer["OurMenu"]</h1>
                <p class="mb-0">@Localizer["MenuDescription"]</p>
            </div>
            @if (isAdmin)
            {
                <div class="col-md-6 text-end">
                    <button class="btn btn-light me-2" data-bs-toggle="modal" data-bs-target="#createDiscountModal">
                        <i class="fas fa-tags me-1"></i>@Localizer["ManageDiscounts"]
                    </button>
                    <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#createProductModal">
                        <i class="fas fa-plus me-1"></i>@Localizer["AddProduct"]
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Discounts Section -->
<section class="featured-discounts py-4 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                @if (Model != null && Model.Products.Any(p => p.DiscountProducts?.Any(dp => dp.Discount.IsCurrentlyActive) == true))
                {
                    <div class="discount-carousel d-flex gap-3 overflow-auto pb-3">
                        @foreach (var product in Model.Products
                                            .Where(p => p.DiscountProducts?.Any(dp => dp.Discount.IsCurrentlyActive) == true)
                                            .Take(6))
                        {
                            var activeDiscount = product.DiscountProducts?.FirstOrDefault(dp => dp.Discount.IsCurrentlyActive)?.Discount;
                            if (activeDiscount != null)
                            {
                                <div class="discount-card bg-white rounded shadow-sm p-3 flex-shrink-0" style="min-width: 200px;">
                                    <div class="position-relative">
                                        <div class="product-image bg-light rounded mb-2" style="height: 120px;">
                                            @if (product.Image != null && !string.IsNullOrEmpty(product.Image.Base64Data))
                                            {
                                                <img src="data:@product.Image.ContentType;base64,@product.Image.Base64Data"
                                                     alt="@(product.Image.AltText ?? product.Name)"
                                                     class="img-fluid rounded"
                                                     style="height: 100%; width: 100%; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center h-100">
                                                    <i class="fas fa-utensils fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="discount-badge position-absolute top-0 end-0">
                                            <span class="badge bg-danger rounded-circle">
                                                -@(activeDiscount.DiscountType == DiscountType.Percentage ? $"{activeDiscount.DiscountValue:0}%" : $"€{activeDiscount.DiscountValue:0.00}")
                                            </span>
                                        </div>
                                    </div>
                                    <h6 class="mb-1">@product.Name</h6>
                                    <div class="price-info">
                                        @if (activeDiscount.DiscountType == DiscountType.Percentage)
                                        {
                                            var discountedPrice = product.BasePrice * (1 - activeDiscount.DiscountValue / 100);
                                            <span class="text-decoration-line-through text-muted small">€@product.BasePrice.ToString("0.00")</span>
                                            <span class="text-success fw-bold">€@discountedPrice.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            var discountedPrice = product.BasePrice - activeDiscount.DiscountValue;
                                            <span class="text-decoration-line-through text-muted small">€@product.BasePrice.ToString("0.00")</span>
                                            <span class="text-success fw-bold">€@discountedPrice.ToString("0.00")</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted">@Localizer["NoDiscounts"]</p>
                }
            </div>
        </div>
    </div>
</section>

<!-- Search and Filter Section -->
<section class="search-filters py-4">
    <div class="container">
        <form method="get" asp-action="Index" asp-controller="Home" class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="@Localizer["SearchPlaceholder"]">
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">@Localizer["AllCategories"]</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Name" selected="@(Model.Category == category.Name)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortBy" class="form-select">
                    <option value="name" selected="@(Model.SortBy == "name")">@Localizer["SortByName"]</option>
                    <option value="price" selected="@(Model.SortBy == "price")">@Localizer["SortByPriceLow"]</option>
                    <option value="pricedesc" selected="@(Model.SortBy == "pricedesc")">@Localizer["SortByPriceHigh"]</option>
                    <option value="category" selected="@(Model.SortBy == "category")">@Localizer["SortByCategory"]</option>
                    <option value="discount" selected="@(Model.SortBy == "discount")">@Localizer["SortByDiscount"]</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i>@Localizer["Filter"]</button>
            </div>
        </form>
    </div>
</section>

<!-- Menu Items Section -->
<section class="menu-items py-4">
    <div class="container">
        @if (Model != null && Model.Products.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    var activeDiscount = product.DiscountProducts?.FirstOrDefault(dp => dp.Discount.IsCurrentlyActive)?.Discount;
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="card menu-item-card h-100 border-0 shadow-sm hover-scale">
                            @if (isAdmin)
                            {
                                <div class="position-absolute top-0 start-0 m-2" style="z-index: 10;">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-light" onclick="editProduct(@product.Id)" title="@Localizer["Edit"]">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light text-danger" onclick="deleteProduct(@product.Id, '@product.Name')" title="@Localizer["Delete"]">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                            <div class="position-relative">
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    @if (product.Image != null && !string.IsNullOrEmpty(product.Image.Base64Data))
                                    {
                                        <img src="data:@product.Image.ContentType;base64,@product.Image.Base64Data"
                                             alt="@(product.Image.AltText ?? product.Name)"
                                             class="img-fluid rounded-top"
                                             style="height: 100%; width: 100%; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <i class="fas fa-utensils fa-3x text-muted"></i>
                                    }
                                </div>
                                @if (activeDiscount != null)
                                {
                                    <div class="discount-badge position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-danger fs-6">
                                            -@(activeDiscount.DiscountType == DiscountType.Percentage ? $"{activeDiscount.DiscountValue:0}%" : $"${activeDiscount.DiscountValue:0.00}")
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="card-body d-flex flex-column">
                                @if (product.ProductCategories?.Any() == true)
                                {
                                    <span class="badge bg-light text-dark small">@product.ProductCategories.First().Category?.Name</span>
                                }
                                <h5 class="card-title mb-2">@product.Name</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description)
                                </p>
                                @if (product.PreparationTime.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="fas fa-clock me-1"></i>@product.PreparationTime @Localizer["Minutes"]</small>
                                    </div>
                                }
                                <div class="price-info mt-auto">
                                    @if (activeDiscount != null)
                                    {
                                        var discountedPrice = activeDiscount.DiscountType == DiscountType.Percentage
                                        ? product.BasePrice * (1 - activeDiscount.DiscountValue / 100)
                                        : product.BasePrice - activeDiscount.DiscountValue;

                                        <div>
                                            <span class="text-decoration-line-through text-muted small">€@product.BasePrice.ToString("0.00")</span>
                                            <span class="text-success fw-bold fs-5">€@discountedPrice.ToString("0.00")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-bold fs-5">€@product.BasePrice.ToString("0.00")</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12 text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">@Localizer["NoMenuItems"]</h4>
                    <p class="text-muted">@Localizer["NoMenuItemsDescription"]</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">@Localizer["ViewAllItems"]</a>
                </div>
            </div>
        }
    </div>
</section>

<!-- Create/Edit Product Modal -->
@if (isAdmin)
{
    <div class="modal fade" id="createProductModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">@Localizer["AddProduct"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="productForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="productId" name="productId" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="name" class="form-label">@Localizer["ProductName"] *</label>
                            <input type="text" class="form-control" id="name" name="name" required />
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">@Localizer["Description"]</label>
                            <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="basePrice" class="form-label">@Localizer["Price"] (€) *</label>
                                <input type="number" step="0.01" class="form-control" id="basePrice" name="basePrice" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="preparationTime" class="form-label">@Localizer["PrepTime"] (@Localizer["Minutes"])</label>
                                <input type="number" class="form-control" id="preparationTime" name="preparationTime" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="imageFile" class="form-label">@Localizer["ProductImage"]</label>
                            <input type="file" class="form-control" id="imageFile" name="imageFile" accept="image/*" />
                            <div id="currentImagePreview"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Categories"] *</label>
                            @foreach (var category in allCategories)
                            {
                                <div class="form-check">
                                    <input class="form-check-input category-check" type="checkbox" name="selectedCategoryIds" value="@category.Id" id="cat@(category.Id)" />
                                    <label class="form-check-label" for="cat@(category.Id)">@category.Name</label>
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Allergens"]</label>
                            @foreach (var allergen in allergens)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input allergen-check" type="checkbox" name="selectedAllergenIds" value="@allergen.Id" id="all@(allergen.Id)" />
                                    <label class="form-check-label" for="all@(allergen.Id)">@allergen.Name</label>
                                </div>
                            }
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="isAvailable" name="isAvailable" checked />
                            <label class="form-check-label" for="isAvailable">@Localizer["Available"]</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked />
                            <label class="form-check-label" for="isActive">@Localizer["Active"]</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["ConfirmDelete"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="deleteMessage"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-danger" id="confirmDelete">@Localizer["Delete"]</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Discount Management Modal -->
    <div class="modal fade" id="createDiscountModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["ManageDiscounts"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Discount List -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6>@Localizer["ActiveDiscounts"]</h6>
                            <button class="btn btn-sm btn-primary" onclick="showDiscountForm()">
                                <i class="fas fa-plus me-1"></i>@Localizer["AddDiscount"]
                            </button>
                        </div>
                        <div id="discountList" class="table-responsive">
                            <!-- Discounts will be loaded here -->
                        </div>
                    </div>

                    <!-- Discount Form (Hidden by default) -->
                    <div id="discountFormContainer" style="display: none;">
                        <hr />
                        <h6 id="discountFormTitle">@Localizer["AddDiscount"]</h6>
                        <form id="discountForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="discountId" name="discountId" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="discountName" class="form-label">@Localizer["DiscountName"] *</label>
                                    <input type="text" class="form-control" id="discountName" name="name" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="discountType" class="form-label">@Localizer["DiscountType"] *</label>
                                    <select class="form-select" id="discountType" name="discountType" required>
                                        <option value="Percentage">@Localizer["Percentage"]</option>
                                        <option value="FixedAmount">@Localizer["FixedAmount"]</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="discountDescription" class="form-label">@Localizer["Description"]</label>
                                <textarea class="form-control" id="discountDescription" name="description" rows="2"></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="discountValue" class="form-label">@Localizer["DiscountValue"] *</label>
                                    <input type="number" step="0.01" class="form-control" id="discountValue" name="discountValue" required />
                                    <small class="text-muted" id="discountValueHint">@Localizer["PercentageHint"]</small>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="startDate" class="form-label">@Localizer["StartDate"] *</label>
                                    <input type="date" class="form-control" id="startDate" name="startDate" required />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="endDate" class="form-label">@Localizer["EndDate"]</label>
                                    <input type="date" class="form-control" id="endDate" name="endDate" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@Localizer["ApplyToProducts"] *</label>
                                <div style="max-height: 200px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
                                    @foreach (var product in Model.Products)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input discount-product-check" type="checkbox" name="selectedProductIds" value="@product.Id" id="discProd@(product.Id)" />
                                            <label class="form-check-label" for="discProd@(product.Id)">
                                                @product.Name (€@product.BasePrice.ToString("0.00"))
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="discountIsActive" name="isActive" checked />
                                <label class="form-check-label" for="discountIsActive">@Localizer["Active"]</label>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
                                <button type="button" class="btn btn-secondary" onclick="hideDiscountForm()">@Localizer["Cancel"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #fdfdb4 0%, #d9d7b6 100%);
        --gradient-secondary: linear-gradient(135deg, #f7dc6f 0%, #e6b800 100%);
        --shadow-soft: 0 10px 40px rgba(0,0,0,0.1);
        --shadow-hover: 0 20px 60px rgba(0,0,0,0.15);
    }

    .menu-header {
        background: var(--gradient-primary);
        color: #333 !important;
    }

        .menu-header h1,
        .menu-header p {
            color: #333 !important;
        }

    .discount-carousel {
        scrollbar-width: thin;
        scrollbar-color: #ffc107 transparent;
    }

        .discount-carousel::-webkit-scrollbar {
            height: 6px;
        }

        .discount-carousel::-webkit-scrollbar-track {
            background: transparent;
        }

        .discount-carousel::-webkit-scrollbar-thumb {
            background: #ffc107;
            border-radius: 3px;
        }

    .menu-item-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

        .menu-item-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover) !important;
        }

    .discount-badge .badge {
        font-size: 0.8rem;
        padding: 5px 8px;
    }

    .hover-scale {
        transition: all 0.3s ease;
    }

    .search-filters {
        background: #f8f9fa;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
        }
</style>

@if (isAdmin)
{
    <script>
        let currentProductId = null;
        let currentDiscountId = null;
        let deleteType = 'product';

        function editProduct(id) {
            fetch(`/Home/GetProduct/${id}`)
                .then(response => response.json())
                .then(product => {
                    document.getElementById('modalTitle').textContent = '@Localizer["EditProduct"]';
                    document.getElementById('productId').value = product.id;
                    document.getElementById('name').value = product.name;
                    document.getElementById('description').value = product.description || '';
                    document.getElementById('basePrice').value = product.basePrice;
                    document.getElementById('preparationTime').value = product.preparationTime || '';
                    document.getElementById('isAvailable').checked = product.isAvailable;
                    document.getElementById('isActive').checked = product.isActive;

                    document.querySelectorAll('.category-check').forEach(cb => cb.checked = false);
                    product.categoryIds.forEach(id => {
                        document.getElementById(`cat${id}`).checked = true;
                    });

                    document.querySelectorAll('.allergen-check').forEach(cb => cb.checked = false);
                    product.allergenIds.forEach(id => {
                        document.getElementById(`all${id}`).checked = true;
                    });

                    if (product.imageUrl) {
                        document.getElementById('currentImagePreview').innerHTML =
                            `<img src="${product.imageUrl}" class="img-thumbnail mt-2" style="max-width: 200px;">`;
                    }

                    new bootstrap.Modal(document.getElementById('createProductModal')).show();
                });
        }

        function deleteProduct(id, name) {
            currentProductId = id;
            document.getElementById('deleteMessage').textContent = `@Localizer["DeleteConfirmMessage"]`.replace('{0}', name);
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        document.getElementById('confirmDelete').addEventListener('click', function() {
            const formData = new FormData();
            formData.append('__RequestVerificationToken', document.querySelector('[name="__RequestVerificationToken"]').value);

            let url;
            if (deleteType === 'discount') {
                url = `/Home/DeleteDiscount/${currentDiscountId}`;
            } else {
                url = `/Home/DeleteProduct/${currentProductId}`;
            }

            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close the delete modal first
                    bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();

                    if (deleteType === 'discount') {
                        location.reload();                   
                    } else {
                        location.reload();
                    }
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while deleting');
            });
        });

        document.getElementById('productForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData();

            // Add anti-forgery token
            formData.append('__RequestVerificationToken', document.querySelector('[name="__RequestVerificationToken"]').value);

            // Add basic fields
            formData.append('Name', document.getElementById('name').value);
            formData.append('Description', document.getElementById('description').value);

            // Format decimal as invariant culture string
            const basePriceInput = document.getElementById('basePrice').value;
            const basePrice = parseFloat(basePriceInput.replace(',', '.'));
            formData.append('BasePrice', basePrice.toFixed(2));

            const prepTime = document.getElementById('preparationTime').value;
            if (prepTime) {
                formData.append('PreparationTime', parseInt(prepTime));
            }

            // Add boolean fields explicitly as true/false strings
            formData.append('IsAvailable', document.getElementById('isAvailable').checked ? 'true' : 'false');
            formData.append('IsActive', document.getElementById('isActive').checked ? 'true' : 'false');

            // Add image file if selected
            const imageFile = document.getElementById('imageFile').files[0];
            if (imageFile) {
                formData.append('ImageFile', imageFile);
            }

            // Add selected categories
            document.querySelectorAll('.category-check:checked').forEach(cb => {
                formData.append('SelectedCategoryIds', cb.value);
            });

            // Add selected allergens
            document.querySelectorAll('.allergen-check:checked').forEach(cb => {
                formData.append('SelectedAllergenIds', cb.value);
            });

            const productId = document.getElementById('productId').value;
            const url = productId ? `/Home/UpdateProduct/${productId}` : '/Home/CreateProduct';

            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred');
            });
        });

        document.getElementById('createProductModal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('productForm').reset();
            document.getElementById('productId').value = '';
            document.getElementById('modalTitle').textContent = '@Localizer["AddProduct"]';
            document.getElementById('currentImagePreview').innerHTML = '';
        });

        // Discount management functions

        function loadDiscounts() {
            fetch('/Home/GetAllDiscounts')
                .then(response => response.json())
                .then(discounts => {
                    const container = document.getElementById('discountList');
                    if (discounts.length === 0) {
                        container.innerHTML = '<p class="text-muted text-center">@Localizer["NoDiscountsYet"]</p>';
                        return;
                    }

                    let html = '<table class="table table-sm"><thead><tr><th>@Localizer["Name"]</th><th>@Localizer["Type"]</th><th>@Localizer["Value"]</th><th>@Localizer["Period"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead><tbody>';

                    discounts.forEach(discount => {
                        const typeLabel = discount.discountType === 'Percentage' ? '%' : '€';
                        const statusBadge = discount.isActive ? '<span class="badge bg-success">@Localizer["Active"]</span>' : '<span class="badge bg-secondary">@Localizer["Inactive"]</span>';
                        const period = `${discount.startDate} - ${discount.endDate || '@Localizer["NoEndDate"]'}`;

                        html += `<tr>
                            <td>${discount.name}</td>
                            <td>${discount.discountType}</td>
                            <td>${discount.discountValue}${typeLabel}</td>
                            <td><small>${period}</small></td>
                            <td>${statusBadge}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick="editDiscount(${discount.id})"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteDiscount(${discount.id}, '${discount.name}')"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>`;
                    });

                    html += '</tbody></table>';
                    container.innerHTML = html;
                });
        }

        function showDiscountForm() {
            document.getElementById('discountFormContainer').style.display = 'block';
            document.getElementById('discountFormTitle').textContent = '@Localizer["AddDiscount"]';
            document.getElementById('discountForm').reset();
            document.getElementById('discountId').value = '';
        }

        function hideDiscountForm() {
            document.getElementById('discountFormContainer').style.display = 'none';
            document.getElementById('discountForm').reset();
        }

        function editDiscount(id) {
            fetch(`/Home/GetDiscount/${id}`)
                .then(response => response.json())
                .then(discount => {
                    document.getElementById('discountFormTitle').textContent = '@Localizer["EditDiscount"]';
                    document.getElementById('discountId').value = discount.id;
                    document.getElementById('discountName').value = discount.name;
                    document.getElementById('discountDescription').value = discount.description || '';
                    document.getElementById('discountType').value = discount.discountType;
                    document.getElementById('discountValue').value = discount.discountValue;
                    document.getElementById('startDate').value = discount.startDate;
                    document.getElementById('endDate').value = discount.endDate || '';
                    document.getElementById('discountIsActive').checked = discount.isActive;

                    document.querySelectorAll('.discount-product-check').forEach(cb => cb.checked = false);
                    discount.productIds.forEach(id => {
                        const checkbox = document.getElementById(`discProd${id}`);
                        if (checkbox) checkbox.checked = true;
                    });

                    document.getElementById('discountFormContainer').style.display = 'block';
                });
        }

        function deleteDiscount(id, name) {
            currentDiscountId = id; // Use separate variable for discount
            deleteType = 'discount'; // Mark this as a discount deletion

            // Use the correct localized message for discount deletion
            document.getElementById('deleteMessage').textContent =
                `@Localizer["DeleteDiscountMsg"]`;

            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteModalEl = document.getElementById('deleteModal');

            // Increase z-index to appear above discount modal
            deleteModalEl.style.zIndex = '1060';
            deleteModalEl.addEventListener('hidden.bs.modal', function() {
                deleteModalEl.style.zIndex = '';
                deleteType = 'product'; // Reset to default
            }, { once: true });

            deleteModal.show();
        }

        document.getElementById('discountForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData();

            formData.append('__RequestVerificationToken', document.querySelector('[name="__RequestVerificationToken"]').value);
            formData.append('Name', document.getElementById('discountName').value);
            formData.append('Description', document.getElementById('discountDescription').value);
            formData.append('DiscountType', document.getElementById('discountType').value);
            formData.append('DiscountValue', parseFloat(document.getElementById('discountValue').value).toFixed(2));
            formData.append('StartDate', document.getElementById('startDate').value);
            formData.append('EndDate', document.getElementById('endDate').value);
            formData.append('IsActive', document.getElementById('discountIsActive').checked);

            document.querySelectorAll('.discount-product-check:checked').forEach(cb => {
                formData.append('SelectedProductIds', cb.value);
            });

            const discountId = document.getElementById('discountId').value;
            const url = discountId ? `/Home/UpdateDiscount/${discountId}` : '/Home/CreateDiscount';

            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    hideDiscountForm();
                    loadDiscounts();
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        });

        // Update discount value hint based on type
        document.getElementById('discountType')?.addEventListener('change', function() {
            const hint = document.getElementById('discountValueHint');
            if (this.value === 'Percentage') {
                hint.textContent = '@Localizer["PercentageHint"]';
            } else {
                hint.textContent = '@Localizer["FixedAmountHint"]';
            }
        });

        // Load discounts when modal opens
        document.getElementById('createDiscountModal')?.addEventListener('shown.bs.modal', function() {
            loadDiscounts();
        });
    </script>
}