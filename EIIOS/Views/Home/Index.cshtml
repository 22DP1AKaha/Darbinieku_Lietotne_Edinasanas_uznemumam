@model EIIOS.ViewModels.MenuViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["MenuTitle"];
    var isAdmin = ViewBag.IsAdmin ?? false;
    var allProducts = ViewBag.AllProducts as List<ProductModel> ?? new List<ProductModel>();
    var today = DateTime.UtcNow.Date;

    // Filter only today's daily menu
    var dailyProducts = allProducts
        .Where(p => p.DailyMenuItems != null && p.DailyMenuItems.Any(d => d.DailyMenu.MenuDate.Date == today))
        .ToList();

    // Extract active discounts related to today's products
    var activeDiscounts = dailyProducts
        .SelectMany(p => p.DiscountProducts?.Select(dp => dp.Discount) ?? Enumerable.Empty<DiscountModel>())
        .Where(d => d != null && d.IsCurrentlyActive)
        .Distinct()
        .ToList();
}

<div class="container my-4">
    <h1 class="mb-4">@Localizer["DailyMenu"]</h1>

    @if (isAdmin)
    {
        <!-- Admin toolbar -->
        <div class="admin-toolbar mb-4 p-3 bg-light rounded-3 shadow-sm d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createProductModal">
                    <i class="fas fa-plus"></i> @Localizer["AddProduct"]
                </button>
                <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createDiscountModal">
                    <i class="fas fa-percent"></i> @Localizer["AddDiscount"]
                </button>
            </div>
        </div>
    }

    @if (activeDiscounts.Any())
    {
        <!-- Horizontal discounts section -->
        <div class="discount-section mb-4">
            <h4 class="mb-3">@Localizer["ActiveDiscounts"]</h4>
            <div class="discount-scroll d-flex flex-row overflow-auto pb-2">
                @foreach (var discount in activeDiscounts)
                {
                    <div class="discount-card border rounded-3 p-3 me-3 bg-danger text-light flex-shrink-0" style="min-width: 250px;">
                        <h5 class="fw-bold">@discount.Name</h5>
                        <p class="mb-1">@discount.Description</p>
                        <p class="mb-0">
                            @if (discount.DiscountType == DiscountType.Percentage)
                            {
                                <span>-@discount.DiscountValue% @Localizer["Off"]</span>
                            }
                            else
                            {
                                <span>-@discount.DiscountValue.ToString("C") @Localizer["Off"]</span>
                            }
                        </p>
                        <small>@Localizer["ValidUntil"]: @(discount.EndDate?.ToString("d") ?? Localizer["NoEndDate"].Value)</small>
                    </div>
                }
            </div>
        </div>
    }

    @if (dailyProducts.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in dailyProducts)
            {
                var imageUrl = product.Image != null ? Url.Content($"~/images/{product.Image.FileName}") : "";
                var activeDiscount = product.DiscountProducts?
                .Select(dp => dp.Discount)
                .FirstOrDefault(d => d != null && d.IsCurrentlyActive);

                decimal discountedPrice = product.BasePrice;
                if (activeDiscount != null)
                {
                    if (activeDiscount.DiscountType == DiscountType.Percentage)
                        discountedPrice = product.BasePrice * (1 - activeDiscount.DiscountValue / 100);
                    else if (activeDiscount.DiscountType == DiscountType.FixedAmount)
                        discountedPrice = product.BasePrice - activeDiscount.DiscountValue;
                }

                <div class="col">
                    <div class="card daily-menu-card h-100 position-relative">
                        @if (activeDiscount != null)
                        {
                            <div class="discount-badge position-absolute top-0 start-0 m-2">
                                @if (activeDiscount.DiscountType == DiscountType.Percentage)
                                {
                                    <span class="badge bg-danger">-@activeDiscount.DiscountValue%</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">-@activeDiscount.DiscountValue.ToString("C")</span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl" class="card-img-top" alt="@product.Name" />
                        }

                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text">@product.Description</p>

                            @if (activeDiscount != null)
                            {
                                <p class="card-text mb-0">
                                    <span class="text-muted text-decoration-line-through">@product.BasePrice.ToString("C")</span>
                                </p>
                                <p class="card-text text-danger fw-bold">@discountedPrice.ToString("C")</p>
                            }
                            else
                            {
                                <p class="card-text fw-bold">@product.BasePrice.ToString("C")</p>
                            }
                        </div>

                        @if (isAdmin)
                        {
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-sm btn-outline-primary" onclick="editProduct(@product.Id)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteProduct(@product.Id, '@product.Name')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">@Localizer["NoDailyMenuYet"]</p>
    }
</div>

@if (isAdmin)
{
    <!-- Product Modal -->
    <div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="productForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitle">@Localizer["AddProduct"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="productId" name="Id" />
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Name"]</label>
                            <input type="text" class="form-control" id="name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Description"]</label>
                            <textarea class="form-control" id="description"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["BasePrice"]</label>
                            <input type="number" class="form-control" id="basePrice" step="0.01" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Image"]</label>
                            <input type="file" class="form-control" id="imageFile" />
                            <div id="currentImagePreview"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                        <button type="submit" class="btn btn-primary">@Localizer["SaveProduct"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Discount Modal -->
    <div class="modal fade" id="createDiscountModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="discountForm">
                    <div class="modal-header">
                        <h5 class="modal-title">@Localizer["AddDiscount"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Name"]</label>
                            <input type="text" class="form-control" id="discountName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["DiscountType"]</label>
                            <select class="form-select" id="discountType">
                                <option value="Percentage">@Localizer["Percentage"]</option>
                                <option value="FixedAmount">@Localizer["FixedAmount"]</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["DiscountValue"]</label>
                            <input type="number" class="form-control" id="discountValue" step="0.01" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["StartDate"]</label>
                            <input type="date" class="form-control" id="discountStart" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["EndDate"]</label>
                            <input type="date" class="form-control" id="discountEnd" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                        <button type="submit" class="btn btn-primary">@Localizer["SaveDiscount"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .daily-menu-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        overflow: hidden;
    }

        .daily-menu-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .daily-menu-card img {
            transition: transform 0.3s ease;
        }

        .daily-menu-card:hover img {
            transform: scale(1.05);
        }

    .discount-badge {
        z-index: 10;
    }

    .discount-section {
        background-color: #fff;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 1rem;
    }

    .discount-scroll::-webkit-scrollbar {
        height: 8px;
    }

    .discount-scroll::-webkit-scrollbar-thumb {
        background-color: #bbb;
        border-radius: 4px;
    }
</style>

<script>
    let currentProductId = null;

    function editProduct(id) {
        fetch(`/Home/GetProduct/${id}`)
            .then(res => res.json())
            .then(product => {
                document.getElementById('modalTitle').textContent = '@Localizer["EditProduct"]';
                document.getElementById('productId').value = product.id;
                document.getElementById('name').value = product.name;
                document.getElementById('description').value = product.description || '';
                document.getElementById('basePrice').value = product.basePrice;
                document.getElementById('currentImagePreview').innerHTML =
                    product.imageUrl ? `<img src="${product.imageUrl}" class="img-thumbnail mt-2" style="max-width: 200px;">` : '';
                new bootstrap.Modal(document.getElementById('createProductModal')).show();
            });
    }

    function deleteProduct(id, name) {
        if (confirm(`@Localizer["ConfirmDelete"] "${name}"?`)) {
            fetch(`/Home/DeleteProduct/${id}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) location.reload();
                    else alert(data.message || '@Localizer["ErrorDeleting"]');
                });
        }
    }

    document.getElementById('productForm')?.addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const productId = document.getElementById('productId').value;
        const url = productId ? `/Home/UpdateProduct/${productId}` : '/Home/CreateProduct`;

        fetch(url, { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.success) location.reload();
                else alert(data.message || '@Localizer["ErrorSavingProduct"]');
            });
    });

    document.getElementById('discountForm')?.addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        fetch('/Home/CreateDiscount', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.success) location.reload();
                else alert(data.message || '@Localizer["ErrorSavingDiscount"]');
            });
    });
</script>
